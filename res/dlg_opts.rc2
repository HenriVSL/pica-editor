// dlg_opts.rc2 - Options property sheet pages (DESIGN 15.8). Owner: T12. CRLF, ASCII.
// Every option has a one-line explanation (ids IDC_OPT_HINT0..9, unique per page, drawn grey) right under it.

IDD_OPT_GENERAL DIALOG DISCARDABLE 0, 0, 252, 170
STYLE DS_3DLOOK | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "General"
FONT 8, "MS Sans Serif"
BEGIN
    AUTOCHECKBOX    "&Restore the last session at startup",IDC_OG_RESTORE,7,6,238,10
    LTEXT           "Reopens the files and tabs that were open when Pica closed.",IDC_OPT_HINT0,19,16,226,8
    AUTOCHECKBOX    "Re&member unsaved changes; save them after",IDC_OG_BACKUP,7,28,158,10
    EDITTEXT        IDC_OG_BACKUPSEC,167,27,24,12,ES_NUMBER
    LTEXT           "s idle",-1,194,29,40,8
    LTEXT           "Unsaved work survives a crash and comes back at the next start.",IDC_OPT_HINT1,19,40,226,8
    AUTOCHECKBOX    "&Ask to save untitled documents on exit",IDC_OG_ASKUNTITLED,7,52,238,10
    LTEXT           "Otherwise new, never-saved documents are kept for next time.",IDC_OPT_HINT2,19,62,226,8
    AUTOCHECKBOX    "&Single instance",IDC_OG_SINGLE,7,74,238,10
    LTEXT           "Opening a file from Explorer adds a tab to the running Pica.",IDC_OPT_HINT3,19,84,226,8
    LTEXT           "Recent &files listed in the File menu:",-1,7,98,140,8
    EDITTEXT        IDC_OG_MRU,149,96,24,12,ES_NUMBER
    LTEXT           "How many recent files the File menu shows (0 to 10).",IDC_OPT_HINT4,19,109,226,8
    AUTOCHECKBOX    "&Check for changes on disk",IDC_OG_CHECKDISK,7,121,238,10
    LTEXT           "Notices when another program changes or deletes an open file.",IDC_OPT_HINT5,19,131,226,8
    AUTOCHECKBOX    "Reload &unmodified files silently",IDC_OG_RELOAD,7,143,238,10
    LTEXT           "Files you haven't edited reload by themselves; else a bar asks.",IDC_OPT_HINT6,19,153,226,8
END

IDD_OPT_EDITOR DIALOG DISCARDABLE 0, 0, 252, 194
STYLE DS_3DLOOK | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "Editor"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "Font:",-1,7,8,24,8
    LTEXT           "",IDC_OE_FONTNAME,33,8,150,8,SS_NOPREFIX
    PUSHBUTTON      "C&hange...",IDC_OE_FONT,190,5,55,14
    LTEXT           "Fixed-width fonts only. Courier New shows the most characters.",IDC_OPT_HINT0,19,20,226,8
    LTEXT           "&Tab width:",-1,7,34,40,8
    EDITTEXT        IDC_OE_TABW,49,32,24,12,ES_NUMBER
    AUTOCHECKBOX    "Insert &spaces",IDC_OE_SPACES,90,33,100,10
    LTEXT           "Tab inserts spaces up to the next tab stop when ticked.",IDC_OPT_HINT1,19,45,226,8
    AUTOCHECKBOX    "Use &language tab settings",IDC_OE_LANGTABS,7,57,238,10
    LTEXT           "Makefiles always use tabs, Python 4 spaces, whatever is set above.",IDC_OPT_HINT2,19,67,226,8
    AUTOCHECKBOX    "Auto-&indent",IDC_OE_AUTOINDENT,7,79,238,10
    LTEXT           "Enter copies the indentation of the line above.",IDC_OPT_HINT3,19,89,226,8
    AUTOCHECKBOX    "Line &numbers",IDC_OE_LINENUM,7,101,238,10
    LTEXT           "Shows line numbers in the left margin.",IDC_OPT_HINT4,19,111,226,8
    AUTOCHECKBOX    "&Word wrap in new tabs",IDC_OE_WRAP,7,123,238,10
    LTEXT           "Long lines wrap at the window edge (View > Word Wrap: one tab).",IDC_OPT_HINT5,19,133,226,8
    AUTOCHECKBOX    "Show white&space and line endings",IDC_OE_SHOWWS,7,145,238,10
    LTEXT           "Draws spaces, tabs and CRLF/LF as faint marks.",IDC_OPT_HINT6,19,155,226,8
    AUTOCHECKBOX    "Highlight matching &braces",IDC_OE_BRACE,7,167,238,10
    LTEXT           "Colours the brace next to the caret and its partner.",IDC_OPT_HINT7,19,177,226,8
END

IDD_OPT_FILES DIALOG DISCARDABLE 0, 0, 252, 170
STYLE DS_3DLOOK | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "Files"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "&New documents:",-1,7,8,60,8
    COMBOBOX        IDC_OF_ENC,69,6,96,80,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    COMBOBOX        IDC_OF_EOL,169,6,76,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Encoding and line ending of new files; ANSI + CRLF suits Win98.",IDC_OPT_HINT0,19,21,226,8
    AUTOCHECKBOX    "&Detect UTF-8 without a BOM",IDC_OF_DETECT,7,33,238,10
    LTEXT           "Valid UTF-8 files open as UTF-8 even without a signature.",IDC_OPT_HINT1,19,43,226,8
    AUTOCHECKBOX    "Open .nfo files as &OEM (DOS)",IDC_OF_NFO,7,55,238,10
    LTEXT           "Shows the box-drawing art of .nfo files (code page 437).",IDC_OPT_HINT2,19,65,226,8
    AUTOCHECKBOX    "Open &binary files in the hex view",IDC_OF_BINHEX,7,77,238,10
    LTEXT           "Files with NUL bytes (programs, images) open as hex.",IDC_OPT_HINT3,19,87,226,8
    LTEXT           "Read files on de&mand above",-1,7,101,104,8
    EDITTEXT        IDC_OF_ONDEMAND,113,99,24,12,ES_NUMBER
    LTEXT           "MB",-1,140,101,20,8
    LTEXT           "Bigger files are read while you scroll; little memory (4 to 64).",IDC_OPT_HINT4,19,112,226,8
    LTEXT           "&Large-file mode above",-1,7,126,104,8
    EDITTEXT        IDC_OF_LARGE,113,124,24,12,ES_NUMBER
    LTEXT           "MB",-1,140,126,20,8
    LTEXT           "Turns off colouring and wrap in big files for speed (1 to 64).",IDC_OPT_HINT5,19,137,226,8
    AUTOCHECKBOX    "&Keep a .bak copy when saving",IDC_OF_BAK,7,149,238,10
    LTEXT           "The previous version stays next to the file as name.bak.",IDC_OPT_HINT6,19,159,226,8
END

IDD_OPT_COLORS DIALOG DISCARDABLE 0, 0, 252, 170
STYLE DS_3DLOOK | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "Colours"
FONT 8, "MS Sans Serif"
BEGIN
    LISTBOX         IDC_OC_LIST,7,6,128,138,LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    CONTROL         "",IDC_OC_SAMPLE,"Static",SS_OWNERDRAW,142,6,103,34
    PUSHBUTTON      "&Colour...",IDC_OC_COLOR,142,46,60,14
    AUTOCHECKBOX    "&Bold",IDC_OC_BOLD,142,65,60,10
    PUSHBUTTON      "&Default",IDC_OC_DEFAULT,142,80,60,14
    PUSHBUTTON      "&Reset All",IDC_OC_RESET,142,98,60,14
    LTEXT           "Pick an item, then Colour... Items marked (system) follow the Windows colours.",
                    IDC_OPT_HINT0,7,148,238,16
END

IDD_OPT_HEX DIALOG DISCARDABLE 0, 0, 252, 170
STYLE DS_3DLOOK | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "Hex"
FONT 8, "MS Sans Serif"
BEGIN
    AUTOCHECKBOX    "Start in &overwrite mode",IDC_OH_OVERWRITE,7,6,238,10
    LTEXT           "Typing in the hex view replaces bytes; Ins switches to inserting.",IDC_OPT_HINT0,19,16,226,8
    AUTOCHECKBOX    "Show the data &inspector",IDC_OH_INSPECTOR,7,28,238,10
    LTEXT           "Shows the bytes at the caret as numbers (int8 to double).",IDC_OPT_HINT1,19,38,226,8
    LTEXT           "Inspector byte order:",-1,7,52,74,8
    AUTORADIOBUTTON "&Little-endian (Intel)",IDC_OH_LE,83,51,80,10,WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "&Big-endian",IDC_OH_BE,167,51,70,10
    LTEXT           "How the inspector reads numbers longer than one byte.",IDC_OPT_HINT2,19,62,226,8
    LTEXT           "Modified-byte colour:",-1,7,77,74,8
    CONTROL         "",IDC_OH_MODSAMPLE,"Static",SS_OWNERDRAW,83,75,40,12
    PUSHBUTTON      "C&olour...",IDC_OH_MODCOLOR,129,74,55,14,WS_GROUP
    LTEXT           "Bytes changed since the last save are drawn in this colour.",IDC_OPT_HINT3,19,90,226,8
END
