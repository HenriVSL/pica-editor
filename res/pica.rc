// pica.rc - resources (DESIGN 15, 18). Owner after Wave 0: overseer. CRLF, ASCII.
// Paths are relative to the project root (rc runs there: rc /r /i res /fo obj\pica.res res\pica.rc).
#include <windows.h>
#include "appinfo.h"
#include "resource.h"
#include "ids_file.h"
#include "ids_find.h"
#include "ids_opts.h"
#include "ids_misc.h"

IDI_APP     ICON    "res\\pica.ico"
IDB_TOOLBAR BITMAP  "res\\toolbar.bmp"

// built-in language files and help (RCDATA, names in res/resource.h)
IDR_LANG_CPP      RCDATA "src\\langs\\cpp.lng"
IDR_LANG_RC       RCDATA "src\\langs\\rc.lng"
IDR_LANG_MAKE     RCDATA "src\\langs\\make.lng"
IDR_LANG_BAT      RCDATA "src\\langs\\bat.lng"
IDR_LANG_INI      RCDATA "src\\langs\\ini.lng"
IDR_LANG_ASM      RCDATA "src\\langs\\asm.lng"
IDR_LANG_PYTHON   RCDATA "src\\langs\\python.lng"
IDR_LANG_HTML     RCDATA "src\\langs\\html.lng"
IDR_LANG_JS       RCDATA "src\\langs\\js.lng"
IDR_LANG_CSS      RCDATA "src\\langs\\css.lng"
IDR_LANG_XML      RCDATA "src\\langs\\xml.lng"
IDR_LANG_MD       RCDATA "src\\langs\\md.lng"
IDR_LANG_DIFF     RCDATA "src\\langs\\diff.lng"
IDR_HELP        RCDATA "src\\help\\help.md"

STRINGTABLE DISCARDABLE
BEGIN
    IDS_APP_TITLE           APP_NAME
    IDM_FILE_NEW            "New (Ctrl+N)"
    IDM_FILE_OPEN           "Open (Ctrl+O)"
    IDM_FILE_SAVE           "Save (Ctrl+S)"
    IDM_FILE_SAVEALL        "Save All (Ctrl+Shift+S)"
    IDM_EDIT_CUT            "Cut (Ctrl+X)"
    IDM_EDIT_COPY           "Copy (Ctrl+C)"
    IDM_EDIT_PASTE          "Paste (Ctrl+V)"
    IDM_EDIT_UNDO           "Undo (Ctrl+Z)"
    IDM_EDIT_REDO           "Redo (Ctrl+Y)"
    IDM_SEARCH_FIND         "Find (Ctrl+F)"
    IDM_SEARCH_REPLACE      "Replace (Ctrl+H)"
    IDM_SEARCH_FIF          "Find in Files (Ctrl+Shift+F)"
    IDM_VIEW_HEX            "Hex View (Ctrl+Shift+H)"
    IDM_VIEW_WRAP           "Word Wrap"
    IDM_VIEW_SHOWWS         "Show Whitespace and Line Endings"
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION APP_VERSION_RC
 PRODUCTVERSION APP_VERSION_RC
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Text and hex editor\0"
            VALUE "FileVersion", APP_VERSION
            VALUE "InternalName", APP_NAME
            VALUE "OriginalFilename", APP_EXE
            VALUE "ProductName", APP_NAME
            VALUE "ProductVersion", APP_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

#include "menu.rc2"
#include "dlg_file.rc2"
#include "dlg_find.rc2"
#include "dlg_goto.rc2"
#include "dlg_opts.rc2"
#include "dlg_misc.rc2"
