// dlg_find.rc2 - Find / Replace / Find in Files dialog (DESIGN 11.4, 11.6). Owner: T11. CRLF, ASCII.
// dlgfind.cpp places and shows the controls per tab (layout_page); the positions here are the Find tab's.
// The tab control comes last (bottom of the z-order, WS_CLIPSIBLINGS) so it never paints over the controls.

IDD_FIND DIALOG DISCARDABLE 0, 0, 348, 116
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Find"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "Fi&nd what:",IDC_FIND_WHAT_LBL,10,26,50,8
    COMBOBOX        IDC_FIND_WHAT,62,24,180,140,CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      ">",IDC_FIND_WHAT_MENU,244,24,14,13
    LTEXT           "Rep&lace with:",IDC_FIND_REPL_LBL,10,44,50,8
    COMBOBOX        IDC_FIND_REPL,62,42,180,140,CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      ">",IDC_FIND_REPL_MENU,244,42,14,13
    LTEXT           "F&iles:",IDC_FIND_MASKS_LBL,10,44,50,8
    COMBOBOX        IDC_FIND_MASKS,62,42,180,140,CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Fo&lder:",IDC_FIND_DIR_LBL,10,62,50,8
    COMBOBOX        IDC_FIND_DIR,62,60,180,140,CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "...",IDC_FIND_BROWSE,244,60,14,13
    CONTROL         "Match &case",IDC_FIND_CASE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,42,56,10
    CONTROL         "&Whole word",IDC_FIND_WORD,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,68,42,56,10
    CONTROL         "Wra&p around",IDC_FIND_WRAP,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,126,42,58,10
    CONTROL         "In &selection",IDC_FIND_INSEL,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,186,42,56,10
    CONTROL         "Sub&folders",IDC_FIND_SUBDIRS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,126,42,58,10
    GROUPBOX        "Direction",IDC_FIND_DIRGRP,10,56,52,36
    CONTROL         "&Up",IDC_FIND_UP,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,16,66,40,10
    CONTROL         "&Down",IDC_FIND_DOWN,"Button",BS_AUTORADIOBUTTON,16,78,40,10
    GROUPBOX        "Search mode",IDC_FIND_MODEGRP,66,56,192,36,WS_GROUP
    CONTROL         "Nor&mal",IDC_FIND_NORMAL,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,72,66,44,10
    CONTROL         "E&xtended",IDC_FIND_EXTENDED,"Button",BS_AUTORADIOBUTTON,118,66,46,10
    CONTROL         "Re&gex",IDC_FIND_REGEX,"Button",BS_AUTORADIOBUTTON,166,66,40,10
    CONTROL         "&Hex bytes",IDC_FIND_HEX,"Button",BS_AUTORADIOBUTTON,208,66,46,10
    CONTROL         ". matches n&ewline",IDC_FIND_DOTALL,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,72,78,120,10
    LTEXT           "",IDC_FIND_STATUS,10,96,248,9,SS_LEFTNOWORDWRAP | SS_NOPREFIX
    DEFPUSHBUTTON   "&Find Next",IDC_FIND_NEXT,268,24,74,14,WS_GROUP
    PUSHBUTTON      "C&ount",IDC_FIND_COUNT,268,41,74,14
    PUSHBUTTON      "Find &All",IDC_FIND_ALL,268,58,74,14
    PUSHBUTTON      "Mar&k All",IDC_FIND_MARK,268,75,74,14
    PUSHBUTTON      "&Replace",IDC_FIND_REPLACE,268,41,74,14
    PUSHBUTTON      "Replace &All",IDC_FIND_REPLALL,268,58,74,14
    PUSHBUTTON      "Replace in all &tabs",IDC_FIND_REPLTABS,268,75,74,14
    PUSHBUTTON      "Find &All",IDC_FIND_FIFGO,268,24,74,14
    PUSHBUTTON      "S&top",IDC_FIND_STOP,268,41,74,14
    PUSHBUTTON      "Close",IDC_FIND_CLOSE,268,92,74,14
    CONTROL         "",IDC_FIND_TAB,"SysTabControl32",WS_CLIPSIBLINGS | WS_TABSTOP,4,4,340,108
END
