// dlg_goto.rc2 - Go To dialog (DESIGN 9.4, 15.9). Owner: T12. CRLF, ASCII.
// The label and the result line are set at run time (text mode: line[:col], hex mode: offset).

IDD_GOTO DIALOG DISCARDABLE 0, 0, 230, 74
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Go To"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "&Line:",IDC_GOTO_LABEL,7,7,216,9
    EDITTEXT        IDC_GOTO_EDIT,7,18,216,13,ES_AUTOHSCROLL
    LTEXT           "",IDC_GOTO_RESULT,7,36,216,9,SS_NOPREFIX
    DEFPUSHBUTTON   "&Go",IDOK,119,53,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,173,53,50,14
END
