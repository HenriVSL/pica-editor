// dlg_misc.rc2 - exit prompt, convert-loss prompt, Properties, About (DESIGN 15.9). Owner: T12. CRLF, ASCII.

IDD_EXITPROMPT DIALOG DISCARDABLE 0, 0, 290, 150
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Unsaved Changes"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "These documents have unsaved changes. Tick the ones to save:",IDC_EXIT_TEXT,7,7,276,9
    CONTROL         "",IDC_EXIT_LIST,"SysListView32",LVS_REPORT | LVS_NOCOLUMNHEADER | LVS_SINGLESEL |
                    LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP,7,19,276,82
    LTEXT           "Keep for Next Session closes Pica now and restores every unsaved change at the next start.",
                    IDC_EXIT_HINT,7,105,276,18
    DEFPUSHBUTTON   "&Save Selected",IDC_EXIT_SAVE,7,129,64,14
    PUSHBUTTON      "&Keep for Next Session",IDC_EXIT_KEEP,75,129,92,14
    PUSHBUTTON      "&Discard",IDC_EXIT_DISCARD,171,129,54,14
    PUSHBUTTON      "Cancel",IDCANCEL,229,129,54,14
END

IDD_CONVERTLOSS DIALOG DISCARDABLE 0, 0, 260, 84
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Convert Encoding"
FONT 8, "MS Sans Serif"
BEGIN
    CONTROL         "",IDC_CONV_ICON,"Static",SS_ICON,7,7,20,20
    LTEXT           "",IDC_CONV_TEXT,36,7,217,48,SS_NOPREFIX
    DEFPUSHBUTTON   "&Convert",IDOK,89,63,52,14
    PUSHBUTTON      "&Go to First",IDC_CONV_GOTO,145,63,52,14
    PUSHBUTTON      "Cancel",IDCANCEL,201,63,52,14
END

IDD_PROPERTIES DIALOG DISCARDABLE 0, 0, 270, 156
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Properties"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "File:",-1,7,8,52,9
    EDITTEXT        IDC_PROP_PATH,62,8,201,9,ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER
    LTEXT           "Size:",-1,7,22,52,9
    EDITTEXT        IDC_PROP_SIZE,62,22,201,9,ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER
    LTEXT           "Modified:",-1,7,36,52,9
    EDITTEXT        IDC_PROP_MODIFIED,62,36,201,9,ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER
    LTEXT           "Created:",-1,7,50,52,9
    EDITTEXT        IDC_PROP_CREATED,62,50,201,9,ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER
    LTEXT           "Encoding:",-1,7,64,52,9
    EDITTEXT        IDC_PROP_ENC,62,64,201,9,ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER
    LTEXT           "Line endings:",-1,7,78,52,9
    EDITTEXT        IDC_PROP_EOL,62,78,201,9,ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER
    LTEXT           "Lines:",-1,7,92,52,9
    EDITTEXT        IDC_PROP_LINES,62,92,201,9,ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER
    LTEXT           "Language:",-1,7,106,52,9
    EDITTEXT        IDC_PROP_LANG,62,106,201,9,ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER
    LTEXT           "State:",-1,7,120,52,9
    EDITTEXT        IDC_PROP_STATE,62,120,201,9,ES_AUTOHSCROLL | ES_READONLY | NOT WS_BORDER
    DEFPUSHBUTTON   "OK",IDOK,213,135,50,14
END

IDD_ABOUT DIALOG DISCARDABLE 0, 0, 230, 122
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About Pica"
FONT 8, "MS Sans Serif"
BEGIN
    ICON            IDI_APP,IDC_ABOUT_ICON,7,7,20,20
    LTEXT           "Pica",IDC_ABOUT_NAME,36,8,187,9,SS_NOPREFIX
    LTEXT           "",IDC_ABOUT_TEXT,36,22,187,50,SS_NOPREFIX
    LTEXT           "",IDC_ABOUT_CFG,36,76,187,18,SS_NOPREFIX
    DEFPUSHBUTTON   "OK",IDOK,173,101,50,14
END
