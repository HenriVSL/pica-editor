$(B)/su_fileops/asan/tm_fileops.o: t_main.cpp | $(B)/su_fileops/asan
	$(CXX) $(WARN) $(CPPFLAGS) $(OPT_asan) -DTF_SUITE=fileops -c $< -o $@
$(B)/su_fileops/asan/%.o: ../src/core/%.cpp | $(B)/su_fileops/asan
	$(CXX) $(WARN) $(CPPFLAGS) $(OPT_asan) -c $< -o $@
$(B)/su_fileops/asan/%.o: %.cpp | $(B)/su_fileops/asan
	$(CXX) $(WARN) $(CPPFLAGS) $(OPT_asan) -c $< -o $@
$(B)/su_fileops/asan:
	mkdir -p $@

