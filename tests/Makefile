MAC_SRCS = $(wildcard mac/*.cpp)
MAC_BINS = $(patsubst mac/%.cpp,$(B)/mac/%,$(MAC_SRCS))
mac: $(MAC_BINS)
	@if [ -z "$(MAC_BINS)" ]; then echo "tests/mac: no programs yet"; fi
	@for b in $(MAC_BINS); do echo "== $$b"; $$b || exit 1; done
$(B)/mac/%: mac/%.cpp $(CORE_SRCS) fs_posix.cpp
	mkdir -p $(B)/mac
	$(CXX) -std=c++11 -O2 -Wall -Wextra -DE_DEBUG -I../src/core -I. -o $@ $< $(CORE_SRCS) fs_posix.cpp

data:
	@if [ -f ../tools/gen_testdata.py ]; then python3 ../tools/gen_testdata.py; else echo "tools/gen_testdata.py: not written yet (T02)"; fi

clean:
	rm -rf $(B) tmp

-include $(wildcard $(B)/*/*.d $(B)/*/*/*.d)
