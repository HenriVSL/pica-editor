# Pica - Mac unit tests (GNU make, Apple clang). GENERATED by tools/gen_make.py: edit the tables there and rerun.
#   make -C tests            = check: lint + strict and ASan/UBSan runs of all suites (coretest)
#   make -C tests <suite>    one suite, both builds, only the sources that suite needs
#   make -C tests mac        C++11 extras in tests/mac/*.cpp (each a standalone program)
#   make -C tests data       regenerate tests/data with tools/gen_testdata.py
#   make -C tests clean
CXX = clang++
WARN = -std=c++98 -pedantic -Wall -Wextra -Werror -Wshadow -fno-exceptions -fno-rtti
CPPFLAGS = -DE_DEBUG -DT01_DOCBIND -I../src/core -I. -MMD -MP
OPT_strict = -O2
OPT_asan = -O1 -g -fno-omit-frame-pointer -fsanitize=address,undefined -fno-sanitize-recover=all
LD_strict =
LD_asan = -fsanitize=address,undefined
B = build
RUN = -q -data data -tmp tmp
export ASAN_OPTIONS = detect_leaks=0

SUITES = estr emem ptree undo doc marks codec detect ucd layout lexer regex search fif hexfmt edtype edlines edhex ini \
         config session fileops adversarial
CORE_SRCS = ../src/core/etypes.cpp ../src/core/emem.cpp ../src/core/estr.cpp ../src/core/esource.cpp ../src/core/ptree.cpp \
            ../src/core/undo.cpp ../src/core/doc.cpp ../src/core/docbind.cpp ../src/core/marks.cpp \
            ../src/core/codec.cpp ../src/core/cptables.cpp ../src/core/detect.cpp ../src/core/ucd.cpp \
            ../src/core/ucdtables.cpp ../src/core/layout.cpp ../src/core/lexer.cpp ../src/core/lexgen.cpp \
            ../src/core/lexhtml.cpp ../src/core/lexmd.cpp ../src/core/regex.cpp ../src/core/rxvm.cpp \
            ../src/core/rxbt.cpp ../src/core/rxpre.cpp ../src/core/search.cpp ../src/core/fif.cpp \
            ../src/core/hexfmt.cpp ../src/core/edtype.cpp ../src/core/edlines.cpp ../src/core/edhex.cpp \
            ../src/core/ini.cpp ../src/core/config.cpp ../src/core/session.cpp ../src/core/faultfs.cpp \
            ../src/core/fileops.cpp

.PHONY: check lint coretest mac data clean $(SUITES)

check: lint coretest

lint:
	python3 ../tools/lint.py

obj = $(addprefix $(B)/$(1)/,$(notdir $(2:.cpp=.o)))

ALL_SRCS = $(CORE_SRCS) fs_posix.cpp t_main.cpp $(addprefix t_,$(addsuffix .cpp,$(SUITES)))

coretest: $(B)/strict/coretest $(B)/asan/coretest
	$(B)/strict/coretest $(RUN)
	$(B)/asan/coretest $(RUN)

$(B)/strict/coretest: $(call obj,strict,$(ALL_SRCS))
	$(CXX) $(OPT_strict) $(LD_strict) -o $@ $^
$(B)/strict/%.o: ../src/core/%.cpp | $(B)/strict
	$(CXX) $(WARN) $(CPPFLAGS) $(OPT_strict) -c $< -o $@
$(B)/strict/%.o: %.cpp | $(B)/strict
	$(CXX) $(WARN) $(CPPFLAGS) $(OPT_strict) -c $< -o $@
$(B)/strict:
	mkdir -p $@

$(B)/asan/coretest: $(call obj,asan,$(ALL_SRCS))
	$(CXX) $(OPT_asan) $(LD_asan) -o $@ $^
$(B)/asan/%.o: ../src/core/%.cpp | $(B)/asan
	$(CXX) $(WARN) $(CPPFLAGS) $(OPT_asan) -c $< -o $@
$(B)/asan/%.o: %.cpp | $(B)/asan
	$(CXX) $(WARN) $(CPPFLAGS) $(OPT_asan) -c $< -o $@
$(B)/asan:
	mkdir -p $@

# Each suite builds in its own folder (build/su_<suite>/...) so parallel agents never race on shared objects.
SU_estr = ../src/core/etypes.cpp ../src/core/emem.cpp ../src/core/estr.cpp t_estr.cpp
estr: $(B)/su_estr/strict/t_estr $(B)/su_estr/asan/t_estr
	$(B)/su_estr/strict/t_estr $(RUN)
	$(B)/su_estr/asan/t_estr $(RUN)
$(B)/su_estr/strict/t_estr: $(call obj,su_estr/strict,$(SU_estr)) $(B)/su_estr/strict/tm_estr.o
	$(CXX) $(OPT_strict) $(LD_strict) -o $@ $^
$(B)/su_estr/strict/tm_estr.o: t_main.cpp | $(B)/su_estr/strict
	$(CXX) $(WARN) $(CPPFLAGS) $(OPT_strict) -DTF_SUITE=estr -c $< -o $@
$(B)/su_estr/strict/%.o: ../src/core/%.cpp | $(B)/su_estr/strict
	$(CXX) $(WARN) $(CPPFLAGS) $(OPT_strict) -c $< -o $@
$(B)/su_estr/strict/%.o: %.cpp | $(B)/su_estr/strict
