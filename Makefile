# ---- release (T18 completes it)
release:
	$(MAKE) /nologo clean
	$(MAKE) /nologo all
	-mkdir release
	-mkdir release\Pica-1.0
	copy $(APP).exe release\Pica-1.0\$(APP).exe
	-copy README.TXT release\Pica-1.0\README.TXT

clean:
	-del obj\*.obj
	-del obj\*.exe
	-del obj\*.res
	-del obj\*.pdb
	-del obj\*.idb
	-del $(APP).exe
	-del coretest.exe
	-del *.pdb
	-del *.ilk
