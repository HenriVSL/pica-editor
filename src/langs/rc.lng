; rc.lng - Win32 resource scripts (rc.exe, VC6 resource editor output). Format: see cpp.lng.
[language]
id=rc
name=Resource Script
extensions=rc;rc2;rct;dlg
case=0
braces=()[]{}
comment=//
line_comment=//
block_comment=/* */
string=" " \
string=' ' \ char
string_prefixes=L
preprocessor=#
number=c
operators=+-*/%=<>!&|^~?:;,.()[]{}

; resource types and statements
keywords1=ACCELERATORS BITMAP CURSOR DIALOG DIALOGEX FONT HTML ICON MENU MENUEX MESSAGETABLE PLUGPLAY RCDATA
keywords1=STRINGTABLE TEXTINCLUDE TYPELIB VERSIONINFO VXD DLGINIT TOOLBAR DESIGNINFO AFX_DIALOG_LAYOUT MANIFEST
keywords1=BEGIN END CAPTION CHARACTERISTICS CLASS EXSTYLE LANGUAGE MENUITEM POPUP SEPARATOR STYLE VERSION BLOCK
keywords1=VALUE FILEVERSION PRODUCTVERSION FILEFLAGSMASK FILEFLAGS FILEOS FILETYPE FILESUBTYPE BUTTON GUIDELINES
keywords1=LEFTMARGIN RIGHTMARGIN TOPMARGIN BOTTOMMARGIN VERTGUIDE HORZGUIDE

; controls and options
keywords2=AUTO3STATE AUTOCHECKBOX AUTORADIOBUTTON CHECKBOX COMBOBOX CONTROL CTEXT DEFPUSHBUTTON EDITTEXT GROUPBOX
keywords2=LISTBOX LTEXT PUSHBOX PUSHBUTTON RADIOBUTTON RTEXT SCROLLBAR STATE3 HEDIT IEDIT
keywords2=DISCARDABLE MOVEABLE FIXED PURE IMPURE PRELOAD LOADONCALL SHARED NONSHARED
keywords2=ALT SHIFT VIRTKEY ASCII NOINVERT CHECKED GRAYED INACTIVE MENUBARBREAK MENUBREAK HELP OWNERDRAW
keywords2=MFT_STRING MFT_SEPARATOR MFT_RIGHTJUSTIFY MFS_CHECKED MFS_GRAYED MFS_DISABLED MFS_DEFAULT

; common style and language constants
keywords3=WS_OVERLAPPED WS_POPUP WS_CHILD WS_MINIMIZE WS_VISIBLE WS_DISABLED WS_CLIPSIBLINGS WS_CLIPCHILDREN
keywords3=WS_MAXIMIZE WS_CAPTION WS_BORDER WS_DLGFRAME WS_VSCROLL WS_HSCROLL WS_SYSMENU WS_THICKFRAME WS_GROUP
keywords3=WS_TABSTOP WS_MINIMIZEBOX WS_MAXIMIZEBOX WS_OVERLAPPEDWINDOW WS_POPUPWINDOW WS_CHILDWINDOW WS_SIZEBOX
keywords3=WS_EX_DLGMODALFRAME WS_EX_NOPARENTNOTIFY WS_EX_TOPMOST WS_EX_ACCEPTFILES WS_EX_TRANSPARENT
keywords3=WS_EX_TOOLWINDOW WS_EX_WINDOWEDGE WS_EX_CLIENTEDGE WS_EX_CONTEXTHELP WS_EX_RIGHT WS_EX_STATICEDGE
keywords3=WS_EX_APPWINDOW WS_EX_CONTROLPARENT
keywords3=DS_ABSALIGN DS_SYSMODAL DS_LOCALEDIT DS_SETFONT DS_MODALFRAME DS_NOIDLEMSG DS_SETFOREGROUND DS_3DLOOK
keywords3=DS_FIXEDSYS DS_NOFAILCREATE DS_CONTROL DS_CENTER DS_CENTERMOUSE DS_CONTEXTHELP DS_SHELLFONT
keywords3=BS_PUSHBUTTON BS_DEFPUSHBUTTON BS_CHECKBOX BS_AUTOCHECKBOX BS_RADIOBUTTON BS_3STATE BS_AUTO3STATE
keywords3=BS_GROUPBOX BS_AUTORADIOBUTTON BS_OWNERDRAW BS_LEFTTEXT BS_TEXT BS_ICON BS_BITMAP BS_LEFT BS_RIGHT
keywords3=BS_CENTER BS_TOP BS_BOTTOM BS_VCENTER BS_PUSHLIKE BS_MULTILINE BS_FLAT
keywords3=ES_LEFT ES_CENTER ES_RIGHT ES_MULTILINE ES_UPPERCASE ES_LOWERCASE ES_PASSWORD ES_AUTOVSCROLL
keywords3=ES_AUTOHSCROLL ES_NOHIDESEL ES_OEMCONVERT ES_READONLY ES_WANTRETURN ES_NUMBER
keywords3=SS_LEFT SS_CENTER SS_RIGHT SS_ICON SS_BLACKRECT SS_GRAYRECT SS_WHITERECT SS_BLACKFRAME SS_GRAYFRAME
keywords3=SS_WHITEFRAME SS_SIMPLE SS_LEFTNOWORDWRAP SS_BITMAP SS_ETCHEDHORZ SS_ETCHEDVERT SS_ETCHEDFRAME
keywords3=SS_SUNKEN SS_NOTIFY SS_NOPREFIX SS_CENTERIMAGE SS_ENDELLIPSIS SS_PATHELLIPSIS
keywords3=LBS_NOTIFY LBS_SORT LBS_NOREDRAW LBS_MULTIPLESEL LBS_OWNERDRAWFIXED LBS_HASSTRINGS LBS_USETABSTOPS
keywords3=LBS_NOINTEGRALHEIGHT LBS_MULTICOLUMN LBS_WANTKEYBOARDINPUT LBS_EXTENDEDSEL LBS_DISABLENOSCROLL
keywords3=LBS_STANDARD CBS_SIMPLE CBS_DROPDOWN CBS_DROPDOWNLIST CBS_OWNERDRAWFIXED CBS_AUTOHSCROLL CBS_SORT
keywords3=CBS_HASSTRINGS CBS_NOINTEGRALHEIGHT CBS_DISABLENOSCROLL SBS_HORZ SBS_VERT
keywords3=VS_VERSION_INFO VS_FFI_FILEFLAGSMASK VS_FF_DEBUG VS_FF_PRERELEASE VS_FF_PATCHED VS_FF_PRIVATEBUILD
keywords3=VS_FF_SPECIALBUILD VOS_NT_WINDOWS32 VOS__WINDOWS32 VOS_DOS_WINDOWS32 VFT_APP VFT_DLL VFT_DRV VFT_FONT
keywords3=VFT_STATIC_LIB VFT_UNKNOWN VFT2_UNKNOWN
keywords3=LANG_NEUTRAL LANG_ENGLISH LANG_FINNISH LANG_GERMAN LANG_FRENCH LANG_SWEDISH SUBLANG_NEUTRAL
keywords3=SUBLANG_DEFAULT SUBLANG_ENGLISH_US SUBLANG_ENGLISH_UK SUBLANG_SYS_DEFAULT
keywords3=IDOK IDCANCEL IDABORT IDRETRY IDIGNORE IDYES IDNO IDCLOSE IDHELP IDC_STATIC
keywords3=VK_BACK VK_TAB VK_RETURN VK_ESCAPE VK_SPACE VK_PRIOR VK_NEXT VK_END VK_HOME VK_LEFT VK_UP VK_RIGHT
keywords3=VK_DOWN VK_INSERT VK_DELETE VK_F1 VK_F2 VK_F3 VK_F4 VK_F5 VK_F6 VK_F7 VK_F8 VK_F9 VK_F10 VK_F11 VK_F12
keywords3=NOT
