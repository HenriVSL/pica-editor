; asm.lng - x86 assembly, MASM style (also TASM / NASM directives). Format: see cpp.lng.
; Instructions 8086 - Pentium II with x87, MMX, 3DNow! and SSE; labels (name: or a non-keyword word in column 0);
; NASM %define lines are PREPROC; numbers 0FFh, 1010b, 0x1F; keywords are case-insensitive.
[language]
id=asm
name=Assembly
extensions=asm;inc;s;nasm;a86;mac
case=0
braces=()[]
comment=;
line_comment=;
string=" " none
string=' ' none
preprocessor=%
label=asm
number=c
ident_start=A-Za-z_@$?.
ident_part=A-Za-z0-9_@$?.
operators=+-*/=<>!&|^~:,()[]{}

; instructions: 8086/186/286/386/486, Pentium, Pentium Pro / II
keywords1=aaa aad aam aas adc add and arpl bound bsf bsr bswap bt btc btr bts call cbw cdq clc cld cli clts cmc
keywords1=cmova cmovae cmovb cmovbe cmovc cmove cmovg cmovge cmovl cmovle cmovna cmovnae cmovnb cmovnbe cmovnc
keywords1=cmovne cmovng cmovnge cmovnl cmovnle cmovno cmovnp cmovns cmovnz cmovo cmovp cmovpe cmovpo cmovs cmovz
keywords1=cmp cmps cmpsb cmpsw cmpsd cmpxchg cmpxchg8b cpuid cwd cwde daa das dec div enter hlt idiv imul in inc
keywords1=ins insb insw insd int int3 into invd invlpg iret iretd iretw ja jae jb jbe jc jcxz jecxz je jg jge jl
keywords1=jle jmp jna jnae jnb jnbe jnc jne jng jnge jnl jnle jno jnp jns jnz jo jp jpe jpo js jz lahf lar lds
keywords1=lea leave les lfs lgdt lgs lidt lldt lmsw lock lods lodsb lodsw lodsd loop loope loopne loopnz loopz
keywords1=loopd looped loopned loopw lsl lss ltr mov movs movsb movsw movsd movsx movzx mul neg nop not or out
keywords1=outs outsb outsw outsd pop popa popad popaw popf popfd popfw push pusha pushad pushaw pushf pushfd
keywords1=pushfw rcl rcr rdmsr rdpmc rdtsc rep repe repne repnz repz ret retf retn rol ror rsm sahf sal sar sbb
keywords1=scas scasb scasw scasd seta setae setb setbe setc sete setg setge setl setle setna setnae setnb setnbe
keywords1=setnc setne setng setnge setnl setnle setno setnp setns setnz seto setp setpe setpo sets setz sgdt shl
keywords1=shld shr shrd sidt sldt smsw stc std sti stos stosb stosw stosd str sub sysenter sysexit test ud2 verr
keywords1=verw wait wbinvd wrmsr xadd xchg xlat xlatb xor
